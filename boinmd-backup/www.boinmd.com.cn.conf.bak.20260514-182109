server {
    listen 80;
    listen [::]:80;
    server_name www.boinmd.com.cn boinmd.com.cn;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.boinmd.com.cn boinmd.com.cn;

    ssl_certificate /etc/letsencrypt/live/www.boinmd.com.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.boinmd.com.cn/privkey.pem;

    root /www/wwwroot/www.boinmd.com.cn;
    index index.php index.html index.htm;

    # WordPress博客
    location ^~ /blog/ {
        root /www/wwwroot/www.boinmd.com.cn/blog;
        try_files $uri $uri/ /index.php?$args;
        
        location ~ \.php$ {
            fastcgi_pass unix:/run/php/php8.3-fpm.sock;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }
    }

    # 主站点 Next.js
    location / {
        try_files $uri $uri/ =404;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
